	(text "Address: JP2-JP4 default to GND -> 0x70.\nMove a jumper to 3V3 for 0x71-0x77."
		(exclude_from_sim no)
		(at 132 156 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "053c94e1-44e5-408a-9c5e-c30871d9bf5b")
	)
	(text "JP1 (open): bridge to let GPIO4 (pin 7) reset the mux,\ne.g. if a channel device holds the bus low."
		(exclude_from_sim no)
		(at 100 22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "689c9f62-4754-4ae4-b2c6-f6f15bad4e0b")
	)
	(text "R2/R3 DNP: host-side pull-ups.\nRaspberry Pi has 1.8k on board;\nfit only if your host has none."
		(exclude_from_sim no)
		(at 86 60 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7bf6aa89-9d80-4a81-a589-7437247914df")
	)
	(text "Optional Raspberry Pi HAT ID EEPROM (all DNP by default).\nFit U2, C3, R4, R5, JP5 for a spec-compliant HAT. Bridge JP5 to write-protect.\nOther hosts ignore pins 27/28."
		(exclude_from_sim no)
		(at 25.4 186 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b1a02853-fb59-499a-a486-dc2b8800ec72")
	)
	(text "Host: any board with a Raspberry Pi-compatible 40-pin header\n(Raspberry Pi, Orange Pi, Banana Pi ...) with I2C on pins 3 (SDA) / 5 (SCL).\nCheck your board's pinout before fitting."
		(exclude_from_sim no)
		(at 25.4 125 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e7830db8-3e2d-49fd-bc89-1ae73e5f0d1b")
	)
	(text "Mux VCC is FIXED at 3.3 V.\nThe TCA9548A's pass-gate switches then translate levels:\neach channel rises to its own pull-up rail (3.3 V or 5 V)\nwhile the host side stays at 3.3 V."
		(exclude_from_sim no)
		(at 132 120 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f8906755-e813-4a74-a891-3ab1903faff0")
	)
