(version 1)
# Custom design rules for JLCPCB standard 2-layer boards (1.6 mm, 1 oz).
# Base limits (clearance, track, via, hole, edge) live in Board Setup -> Constraints;
# these rules add checks the built-in constraints can't express.
# Capabilities: https://jlcpcb.com/capabilities/pcb-capabilities

(rule "THT pad annular ring"
	(constraint annular_width (min 0.25))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'"))

(rule "Copper to unplated hole"
	(constraint hole_clearance (min 0.3))
	(condition "A.Pad_Type == 'NPTH, mechanical'"))

(rule "Header GND pins solid"
	# F.Cu between the 40-pin header's pins is too cut up for thermal spokes
	(constraint zone_connection solid)
	(condition "A.Type == 'Pad' && A.Parent.Reference == 'J1' && A.NetName == 'GND'"))
